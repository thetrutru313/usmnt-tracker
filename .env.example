# ── USMNT Tracker — environment variable reference ───────────────────────────
#
# Copy this file to .env and fill in the values for local development.
# Never commit a filled-in .env to version control.
#
# Replit injects the variables it manages (ADMIN_PASSWORD, API_FOOTBALL_KEY,
# DEFAULT_OBJECT_STORAGE_BUCKET_ID, etc.) automatically in the workspace and
# in production deploys. You only need .env when running outside Replit.

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.  In Replit this is wired up automatically by
# the built-in database integration.
DATABASE_URL=

# ── Admin panel ───────────────────────────────────────────────────────────────

# Password protecting the /admin panel.  Accepted once at
# POST /api/admin/transparency/verify; a successful login issues a short-lived
# UUID session token (SHA-256-hashed, stored in admin_sessions).  Choose a
# strong random value.
ADMIN_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────
#
# Comma-separated list of exact origins the API server will accept cross-origin
# requests from.  This is in addition to:
#   • Any http://localhost:<port> origin when NODE_ENV !== "production"
#     (added automatically — no entry needed here for local dev).
#   • The Replit dev domain (https://<repl>.replit.dev) when REPLIT_DEV_DOMAIN
#     is set (added automatically in the Replit workspace).
#   • Replit deployment domains from REPLIT_DOMAINS (added automatically).
#
# Example: if your front-end is served from a custom domain in staging:
#   ALLOWED_ORIGINS=https://staging.example.com,https://preview.example.com
ALLOWED_ORIGINS=

# ── Object storage ───────────────────────────────────────────────────────────

# Replit App Storage bucket ID.  Injected automatically in Replit; set this
# if running the API server outside the workspace.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# Directory prefix (including bucket name) used for private (admin-only)
# uploads.  Example: replit-objstore-<uuid>/private
PRIVATE_OBJECT_DIR=

# Comma-separated search paths (including bucket names) for public objects.
# Example: replit-objstore-<uuid>/public
PUBLIC_OBJECT_SEARCH_PATHS=

# ── External APIs ─────────────────────────────────────────────────────────────

# API-Football (rapidapi.com) key for live fixture and player data (paid plan).
API_FOOTBALL_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────

# Pino log level: trace | debug | info | warn | error | fatal
# Defaults to "info" when unset.
LOG_LEVEL=

# ── Not implemented / deferred ────────────────────────────────────────────────
#
# SPORTMONKS_API_TOKEN — A Sportmonks integration was considered but never
# implemented (sportmonksSync.ts was never created).  The secret exists in the
# Replit secrets panel but nothing reads it.  It can be deleted.
#
# SESSION_SECRET — Set during an earlier architecture exploration; nothing
# reads it.  It can be deleted from the Replit secrets panel.
