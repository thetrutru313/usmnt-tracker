# ── USMNT Tracker — environment variable reference ───────────────────────────
#
# Copy this file to .env and fill in the values for local development.
# Never commit a filled-in .env to version control.
#
# Replit secrets (ADMIN_PASSWORD, API_FOOTBALL_KEY, SESSION_SECRET, etc.)
# are injected automatically in the Replit workspace and in production
# deploys; you only need .env when running outside Replit.

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.  In Replit this is wired up automatically by
# the built-in database integration.
DATABASE_URL=postgresql://user:password@localhost:5432/usmnt_tracker

# ── Admin panel ───────────────────────────────────────────────────────────────

# Password protecting the /admin panel.  Choose a strong random value.
ADMIN_PASSWORD=change-me

# Session signing secret used to HMAC admin session tokens.
SESSION_SECRET=change-me

# ── CORS ─────────────────────────────────────────────────────────────────────
#
# Comma-separated list of exact origins the API server will accept cross-origin
# requests from.  This is in addition to:
#   • Any http://localhost:<port> origin when NODE_ENV !== "production"
#     (added automatically — no entry needed here for local dev).
#   • The Replit dev domain (https://<repl>.replit.dev) when REPLIT_DEV_DOMAIN
#     is set (added automatically in the Replit workspace).
#   • Replit deployment domains from REPLIT_DOMAINS (added automatically).
#
# Example: if your front-end is served from a custom domain in staging:
#   ALLOWED_ORIGINS=https://staging.example.com,https://preview.example.com
ALLOWED_ORIGINS=

# ── Object storage ───────────────────────────────────────────────────────────

# Replit Object Storage bucket ID.  Injected automatically in Replit; set this
# if running the API server outside the workspace.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# Directory prefix used for private (admin-only) uploads.
PRIVATE_OBJECT_DIR=

# Comma-separated search paths for public objects.
PUBLIC_OBJECT_SEARCH_PATHS=

# ── External APIs ─────────────────────────────────────────────────────────────

# API-Football (rapidapi.com) key for live fixture and player data.
API_FOOTBALL_KEY=

# Sportmonks API token for fixture and stats data.
SPORTMONKS_API_TOKEN=
